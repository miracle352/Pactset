# Supabase publishable values are intentionally browser-safe; RLS is the authorization boundary.
# Never put a Supabase secret/service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stage 2B placeholders. These are not used by Stage 2A.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
PACTSET_TUSD_ISSUER=replace_with_testnet_public_key
PACTSET_TGBP_ISSUER=replace_with_testnet_public_key
PACTSET_TAUD_ISSUER=replace_with_testnet_public_key
